{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.goadesign/chorus",
  "title": "Chorus",
  "description": "Real-time #channels, @agent DMs, cross-model review, and live web UI for coding agents.",
  "version": "1.0.1",
  "websiteUrl": "https://goa.design/chorus/",
  "repository": {
    "url": "https://github.com/goadesign/chorus",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@goadesign/chorus",
      "version": "1.0.1",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ],
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:9440/mcp"
      }
    }
  ]
}
